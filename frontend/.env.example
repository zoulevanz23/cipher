# Copy to .env and fill in to enable Google sign-in.
#
# SETUP (one time, ~5 minutes):
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials → OAuth client ID → Application type: Web application
# 3. Under "Authorized JavaScript origins" add:
#      http://localhost:5173
#    (plus your production origin when you deploy)
# 4. Paste the Client ID below and restart `npm run dev`.
#
# The backend also needs it (same value):
#   - Windows (PowerShell):  $env:CIPHER_GOOGLE_CLIENT_ID="..."
#   - Linux/macOS:           export CIPHER_GOOGLE_CLIENT_ID="..."
# Without it, the "Continue with Google" button is hidden and the
# backend returns 500 "not configured" for direct API calls.

VITE_GOOGLE_CLIENT_ID=
